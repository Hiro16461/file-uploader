<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File manager</title>
</head>
<body>
    <h1>My storage</h1>
    <p>Welcome, <%= currentUser.username %> | <a href="/logout">Log out</a></p>
    <hr>

    <% if(currentFolder) { %>
        <p><a href="/">Back to home route</a>&gt; <strong><%= currentFolder.name %></strong></p>
        <form action="/folders/<%= currentFolder.id %>/update" method="post" style="display: inline-block;">
            <input type="text" name="name" value="<%= currentFolder.name %>" required>
            <button type="submit">Folder name change</button>
        </form>
        <form action="/folders/<%= currentFolder.id %>/delete" method="post" style="display: inline-block;">
            <button type="submit" onclick="return confirm('Are you sure you want to delete this folder?')">Delete the folder</button>
        </form>
    <% } else { %>
        <p><strong>Current location: Route</strong></p>
    <% } %>
    <hr>

    <h3>Create new folder</h3>
    <form action="/folders" method="post">
        <input type="text" name="name" placeholder="Folder name" required>
        <% if(currentFolder) { %>
            <input type="hidden" name="parentId" value="<%= currentFolder.id %>">
        <% } %>
        <button type="submit">Create folder</button>
    </form>

    <h3>File upload</h3>
    <form action="/upload" method="post" enctype="multipart/form-data">
        <input type="file" name="file" required>
        <% if(currentFolder) { %>
            <input type="hidden" name="folderId" value="<%= currentFolder.id %>">
        <% } %>
        <button type="submit">Upload</button>
    </form>

    <h3>Folder</h3>
    <ul>
        <% if(folders.length === 0) { %>
            <li>Folder does not exist.</li>
        <%} %>
        <% folders.forEach(folder => { %>
            <li>📁 <a href="/folders/<%= folder.id %>"><%= folder.name %></a></li>
        <% }) %>
    </ul>

    <h3>File</h3>
    <ul>
           <% if(files.length === 0) { %>
            <li>File does not exist.</li>
        <%} %>
        <% files.forEach(file => { %>
            <li>
               📄 <a href="/files/<%= file.id %>"><%= file.name %></a>
               (<%= Math.round(file.size / 1024) %> KB)
            </li>
        <% }) %>
    </ul>
</body>
</html>